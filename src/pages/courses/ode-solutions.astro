---
import DetailLayout from "../../layouts/DetailLayout.astro";
import { getLibraryEntry } from "../../data/library";

const entry = getLibraryEntry("ode-solutions");
---

<DetailLayout {entry}>
  <section class="detail-section">
    <h2>README</h2>
    <p>
      这是柳彬老师的常微分方程课程学习过程中整理的书后题答案合集，主要用于复习、查漏补缺和对照推导思路。文件里还有些许刘保平老师布置的拓展题，希望对大家有所帮助。
    </p>

  </section>

  <section class="detail-section">
    <h2>文件信息</h2>
    <ul class="meta-list">
      <li>
        <strong>类型</strong>
        <span>课程资料 / 习题答案</span>
      </li>
      <li>
        <strong>课程</strong>
        <span>常微分方程</span>
      </li>
      <li>
        <strong>文件</strong>
        <span>ode-solutions.pdf</span>
      </li>
    </ul>
  </section>
</DetailLayout>
