---
import DetailLayout from "../../layouts/DetailLayout.astro";
import { getLibraryEntry } from "../../data/library";

const entry = getLibraryEntry("abstract-algebra");
---

<DetailLayout {entry}>
  <section class="detail-section">
    <h2>README</h2>
    <p>
      冯荣权《代数学三》书后题答案合集，是北大抽代课教材答案。
    </p>
  </section>

  <section class="detail-section">
    <h2>文件信息</h2>
    <ul class="meta-list">
      <li>
        <strong>类型</strong>
        <span>课程资料 / 习题答案</span>
      </li>
      <li>
        <strong>课程</strong>
        <span>代数学三（抽象代数）</span>
      </li>
      <li>
        <strong>文件</strong>
        <span>抽象代数习题答案.pdf</span>
      </li>
    </ul>
  </section>
</DetailLayout>
