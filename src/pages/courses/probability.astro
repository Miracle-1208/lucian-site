---
import DetailLayout from "../../layouts/DetailLayout.astro";
import { getLibraryEntry } from "../../data/library";

const entry = getLibraryEntry("probability");
---

<DetailLayout {entry}>
  <section class="detail-section">
    <h2>README</h2>
    <p>
      这里整理了概率论期末题与答案，便于复习、查漏补缺和考前回顾。
    </p>
  </section>

  <section class="detail-section">
    <h2>文件信息</h2>
    <ul class="meta-list">
      <li>
        <strong>类型</strong>
        <span>课程资料 / 期末题与答案</span>
      </li>
      <li>
        <strong>课程</strong>
        <span>概率论</span>
      </li>
      <li>
        <strong>文件</strong>
        <span>概率论期末题与答案.pdf</span>
      </li>
    </ul>
  </section>
</DetailLayout>
