---
import DetailLayout from "../../layouts/DetailLayout.astro";
import { getLibraryEntry } from "../../data/library";

const entry = getLibraryEntry("huanjing");
---

<DetailLayout {entry}>
  <section class="detail-section">
    <h2>README</h2>
    <p>
      这是一篇日记体小说，故事背景是大一的时候我的转专业经历。
    </p>

  </section>

  <section class="detail-section">
    <h2>文件信息</h2>
    <ul class="meta-list">
      <li>
        <strong>类型</strong>
        <span>文章 / 课程论文</span>
      </li>
      <li>
        <strong>课程</strong>
        <span>心理学导论</span>
      </li>
      <li>
        <strong>文件</strong>
        <span>幻镜.pdf</span>
      </li>
    </ul>
  </section>
</DetailLayout>
