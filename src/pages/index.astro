---
import CommentThread from "../components/CommentThread.astro";
import LibraryShelf from "../components/LibraryShelf.astro";
import ThemeDock from "../components/ThemeDock.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout home>
  <main>
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="avatar-frame">
          <img src="/avatar.jpg" alt="Lucian 的头像" class="avatar-img" />
        </div>

        <p class="eyebrow">A personal archive</p>
        <h1 id="hero-title">Lucian</h1>
        <div class="name-cn">在证明与梦之间</div>

        <p class="motto">
          在数学中寻找秩序，在文字中安放心事，<br />
          在人工智能与心理学的交界，理解人如何与世界相遇
        </p>

        <div class="profile-meta" aria-label="个人关键词">
          <span>INFJ</span>
          <span>Mathematics</span>
          <span>AI</span>
          <span>Psychology</span>
          <span>Writing</span>
        </div>
      </div>

      <a class="scroll-cue" href="#about">Explore</a>
    </section>

    <section class="content-section" id="about" aria-labelledby="about-title">
      <p class="section-kicker">About me</p>
      <h2 class="section-heading" id="about-title">这里可以是花园、可以是大海、也可以是星空之外。</h2>

      <div class="about-grid">
        <div class="paper-card about-prose">
          <p>
            你好，我是 <strong>徐博达</strong>，由北京大学 23 级化院转专业至北京大学 24 级数院。
          </p>
          <p>INFJ-2w3。</p>
          <p>
            这个网站会用来存放我的项目、文章、课程笔记、研究想法，
            以及一些尚未完成却仍在发光的念头。欢迎来到 xbd 的自留地！
          </p>
        </div>

        <aside class="paper-card coordinate-card" aria-label="个人坐标">
          <span class="coordinate-title">Current coordinates</span>
          <dl class="coordinate-list">
            <div>
              <dt>Place</dt>
              <dd>北京大学</dd>
            </div>
            <div>
              <dt>Field</dt>
              <dd>Mathematics</dd>
            </div>
            <div>
              <dt>Somewhere</dt>
              <dd>月光与潮汐之间</dd>
            </div>
          </dl>
        </aside>
      </div>

      <div class="contact-grid" id="contact">
        <a class="contact-item" href="mailto:947216434@qq.com">
          <span class="contact-label">Email</span>
          <span class="contact-value">947216434@qq.com <span class="contact-arrow">↗</span></span>
        </a>
        <div class="contact-item">
          <span class="contact-label">公众号</span>
          <span class="contact-value">零点碎梦瓶</span>
        </div>
        <div class="contact-item">
          <span class="contact-label">知乎</span>
          <span class="contact-value">荒糖</span>
        </div>
      </div>
    </section>

    <div class="library-book" id="library">
      <LibraryShelf section="projects" />
      <LibraryShelf section="courses" />
      <LibraryShelf section="writings" />
      <LibraryShelf section="music" />
    </div>

    <section class="guestbook-section" id="guestbook" aria-label="留言板">
      <CommentThread
        issueTerm="/guestbook"
        eyebrow="Guestbook"
        title="留言板"
        description="昵称可以留空，也不需要登录。"
      />
    </section>

    <ThemeDock />
  </main>
</Layout>
