---
const { home = false } = Astro.props;
const prefix = home ? "" : "/";
---

<header class="site-header" data-site-header>
  <a class="brand" href="/" aria-label="回到 Lucian's World 首页">
    <span class="brand-mark" aria-hidden="true">L</span>
    <span>Lucian's World</span>
  </a>

  <nav class="site-nav" aria-label="主导航">
    <a href={`${prefix}#about`}>About</a>
    <a href={`${prefix}#library`}>Library</a>
    <a href={`${prefix}#guestbook`}>Guestbook</a>
  </nav>

  <button class="search-trigger" type="button" data-search-open aria-label="打开全站搜索">
    <span aria-hidden="true">⌕</span>
    <span class="search-trigger-text">搜索</span>
    <kbd>⌘ K</kbd>
  </button>
</header>
