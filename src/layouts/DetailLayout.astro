---
import CommentThread from "../components/CommentThread.astro";
import { libraryEntries, type LibraryEntry } from "../data/library";
import Layout from "./Layout.astro";

const { entry } = Astro.props as { entry: LibraryEntry };
const currentIndex = libraryEntries.findIndex((item) => item.id === entry.id);
const previous = libraryEntries[(currentIndex - 1 + libraryEntries.length) % libraryEntries.length];
const next = libraryEntries[(currentIndex + 1) % libraryEntries.length];
const pageNumber = String(currentIndex + 1).padStart(2, "0");
const total = String(libraryEntries.length).padStart(2, "0");
---

<Layout title={`${entry.title}｜Lucian`} description={entry.description}>
  <main class="detail-main">
    <div class="detail-tools">
      <a class="back-link" href={`/#${entry.section}`}>← <span>合上这一页</span></a>
      <span class="folio-count">Folio {pageNumber} / {total}</span>
    </div>

    <article class="open-book" style={`view-transition-name: ${entry.transitionName}`}>
      <div class="book-cover">
        <div class="cover-meta">
          <span>{entry.sectionLabel}</span>
          <span aria-hidden="true">·</span>
          <span class="cover-tag">{entry.tag}</span>
        </div>

        <div class="cover-title-wrap">
          <h1>{entry.title}</h1>
          <p>{entry.description}</p>
        </div>

        <div class="cover-actions">
          {entry.resourceHref && (
            <a class="primary-button" href={entry.resourceHref} target="_blank" rel="noreferrer">
              {entry.resourceLabel ?? "打开文件"} <span aria-hidden="true">↗</span>
            </a>
          )}
          {entry.fileName && <span class="file-caption">{entry.fileName}</span>}
        </div>
      </div>

      <div class="book-page">
        <div class="page-running-head">
          <span>Lucian's World</span>
          <span>{entry.tag}</span>
        </div>

        <div class="detail-slot">
          <slot />
        </div>
        <span class="page-number" aria-hidden="true">— {pageNumber} —</span>
      </div>
    </article>

    <nav class="entry-pager" aria-label="相邻条目">
      <a href={previous.href}>
        <span class="pager-label">← Previous folio</span>
        <span class="pager-title">{previous.title}</span>
      </a>
      <a href={next.href}>
        <span class="pager-label">Next folio →</span>
        <span class="pager-title">{next.title}</span>
      </a>
    </nav>

    <CommentThread
      issueTerm={Astro.url.pathname}
      eyebrow="Comments"
      title="关于这一页，你想说些什么？"
      description="昵称可以留空，不需要登录。可以留下问题、补充或读后感。"
    />
  </main>
</Layout>
